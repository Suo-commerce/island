# The shared Flare session server on the Island server, as a system
# service; see docs/server.md. It holds no writer key: terminals sign
# their own verses. It keeps the sessions and its own replica of the log
# in /var/lib/island/flare.
#
# Settings come from /etc/island/island.env: ISLAND_ROOT.
# It listens on the server's WireGuard address only. Its agent socket,
# /run/flare-server/agent.sock, hands the agent's tasks to island-socket
# and takes its replies from island-sender, each told by its uid
# (docs/slice-2.md, "Actions and the sender"). It serves the face, the
# page in /usr/local/share/flare/face, at http://10.77.0.1:4749/, and
# lets that page alone attach to a session (docs/server.md, section 10).
[Unit]
Description=Flare session server
Requires=wg-quick@wg-island.service
Wants=island-broker.service
After=wg-quick@wg-island.service island-broker.service

[Service]
User=island
Group=island
EnvironmentFile=/etc/island/island.env
# The page over https, once there is a certificate: /etc/island/flare-tls.env
# holds one line, FLARE_TLS=--tls-listen 10.77.0.1:443 --tls-cert ...
# --tls-key ... --allow-host NAME (docs/server.md, "The face over HTTPS").
# Without the file nothing changes.
EnvironmentFile=-/etc/island/flare-tls.env
ExecStart=/usr/local/bin/flare-server --broker http://10.77.0.1:4747 --root ${ISLAND_ROOT} --data /var/lib/island/flare --listen 10.77.0.1:4749 --agent-socket /run/flare-server/agent.sock --task-reader island-socket --face /usr/local/share/flare/face $FLARE_TLS
# Port 443, and no other privilege.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RuntimeDirectory=flare-server
RuntimeDirectoryMode=0755
# The broker may still be starting.
Restart=on-failure
RestartSec=5

# It writes its sessions and replica, and nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/island
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
